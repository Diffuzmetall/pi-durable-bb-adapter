{
  "name": "bb-plugin-provider-pi-durable",
  "version": "0.3.0-beta.1",
  "private": true,
  "description": "BB provider for admitted native Pi Durable SDK 1.3 sessions and native subagent threads",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24.19.0 <25", "bb": "0.46.0", "bbPluginSdk": ">=0.6.15 <0.7" },
  "repository": { "type": "git", "url": "https://github.com/Diffuzmetall/pi-durable-bb-adapter.git" },
  "bb": {
    "name": "Pi Durable",
    "description": "Run BB threads with Pi Durable ACID SQLite runtime.",
    "branding": { "icon": "./icons/pi-durable.svg" },
    "experimental_providers": [{ "kind": "agent", "id": "pi-durable", "displayName": "Pi Durable" }],
    "server": "./src/server.ts",
    "host": "./src/provider/host/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --experimental-transform-types --test tests/provider/*.test.ts tests/packaging/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "native:prepare": "node scripts/prepare-native.mjs",
    "native:configure": "node scripts/configure-native.mjs",
    "native:fixture": "node scripts/build-native-fixture.mjs",
    "test:native": "node scripts/check-native.mjs",
    "bb:prepare": "node scripts/prepare-bb.mjs",
    "bb:start": "node scripts/start-bb.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@get-bb/plugin-sdk": "0.6.15",
    "esbuild": "0.28.1",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.5"
  },
  "overrides": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0"
  },
  "devDependencies": { "typescript": "5.7.3", "@types/node": "24.0.0", "@types/proper-lockfile": "4.1.4" }
}

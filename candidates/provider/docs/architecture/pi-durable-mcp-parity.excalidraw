    {
      "id": "card_55",
      "type": "rectangle",
      "x": 40,
      "y": 890,
      "width": 1720,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",

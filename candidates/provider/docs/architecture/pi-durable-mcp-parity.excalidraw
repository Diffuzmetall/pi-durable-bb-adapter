      ],
      "version": 1,
      "isDeleted": false
    },
    {
      "id": "card_text_10",
      "type": "text",
      "x": 72,
      "y": 440,
      "width": 376,
      "height": 90,
      "containerId": "card_9",
      "text": "3. Diff синтез для тулов write и edit\n[diff-utils.ts (~185 строк)]\n\n• BB IDE требует git unified diff карточки (patch @@ ... @@)\n• Pi Durable отдает просто сырой текст -> плагин на лету\n  строит честный diff для интерфейса сравнения",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#1971c2",
      "version": 1,
      "isDeleted": false
    },
    {
      "id": "card_11",
      "type": "rectangle",
      "x": 60,
      "y": 560,
      "width": 400,
      "height": 110,
      "angle": 0,
      "strokeColor": "#1971c2",
